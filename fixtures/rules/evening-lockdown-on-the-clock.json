{
  "name": "evening-lockdown-on-the-clock",
  "description": "From Shutdown Time until the next Workday Start, Evening Lockdown blocks the Work List and the Distraction List, on the clock alone, with no ritual and no Block.",
  "initial_state": {
    "blocks": [],
    "settings": { "workdays": [1, 2, 3, 4, 5], "workday_start": "09:00", "shutdown_time": "17:00" },
    "settings_since": "2026-01-05T08:00:00Z"
  },
  "steps": [
    {
      "server_time": "2026-01-05T16:59:59Z",
      "expect": { "enforcement": { "blocked_domains": [], "blocked_apps": [], "ritual": "none" } }
    },
    {
      "server_time": "2026-01-05T17:00:00Z",
      "expect": {
        "enforcement": {
          "blocked_domains_include": ["github.com", "slack.com", "mail.google.com", "youtube.com", "youtu.be", "reddit.com", "cnn.com", "x.com", "amazon.com"],
          "blocked_apps": ["com.Slack", "com.discord", "com.hnc.Discord", "com.microsoft.teams", "com.microsoft.teams2", "com.tinyspeck.slackmacgap"]
        }
      }
    },
    {
      "server_time": "2026-01-05T23:59:59Z",
      "expect": { "enforcement": { "blocked_domains_include": ["github.com", "youtube.com"] } }
    },
    {
      "server_time": "2026-01-06T00:00:00Z",
      "expect": { "enforcement": { "blocked_domains_include": ["github.com", "youtube.com"] } }
    },
    {
      "server_time": "2026-01-06T08:59:59Z",
      "expect": { "enforcement": { "blocked_domains_include": ["slack.com", "facebook.com", "fbcdn.net"] } }
    },
    {
      "server_time": "2026-01-06T09:00:00Z",
      "expect": { "enforcement": { "blocked_domains": [], "blocked_apps": [] } }
    },
    {
      "server_time": "2026-01-06T12:00:00Z",
      "command": { "type": "start_block", "block_id": "b1", "minutes": 60, "deep": false },
      "expect": { "outcome": "accepted", "enforcement": { "blocked_domains_include": ["youtube.com"], "blocked_domains_exclude": ["github.com"] } }
    }
  ]
}
