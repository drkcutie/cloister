{
  "name": "no-missed-ritual-before-settings",
  "description": "The first settings record when they began (settings_since); a ritual due before then doesn't exist, so a new account starts with no Missed Ritual, while Evening Lockdown still runs on the clock.",
  "initial_state": { "blocks": [] },
  "steps": [
    {
      "server_time": "2026-01-07T18:00:00Z",
      "command": { "type": "change_settings", "workdays": [1, 2, 3, 4, 5], "workday_start": "09:00", "shutdown_time": "17:00" },
      "expect": {
        "outcome": "accepted",
        "state": {
          "blocks": [],
          "settings": { "workdays": [1, 2, 3, 4, 5], "workday_start": "09:00", "shutdown_time": "17:00" },
          "settings_since": "2026-01-07T18:00:00Z"
        },
        "enforcement": { "ritual": "none", "blocked_domains_include": ["github.com", "youtube.com"] }
      }
    },
    {
      "server_time": "2026-01-07T18:01:00Z",
      "command": { "type": "complete_ritual", "typed": "Shutdown complete" },
      "expect": { "outcome": "rejected", "reason": "ritual_not_due" }
    },
    {
      "server_time": "2026-01-08T09:00:00Z",
      "expect": { "enforcement": { "ritual": "none", "blocked_domains": [] } }
    },
    {
      "server_time": "2026-01-08T10:00:00Z",
      "command": { "type": "change_settings", "workdays": [1, 2, 3, 4, 5], "workday_start": "09:00", "shutdown_time": "16:00" },
      "expect": {
        "outcome": "accepted",
        "state": {
          "blocks": [],
          "past_settings": [
            { "workdays": [1, 2, 3, 4, 5], "workday_start": "09:00", "shutdown_time": "17:00", "until": "2026-01-08T10:00:00Z" }
          ],
          "settings": { "workdays": [1, 2, 3, 4, 5], "workday_start": "09:00", "shutdown_time": "16:00" },
          "settings_since": "2026-01-07T18:00:00Z"
        }
      }
    },
    { "server_time": "2026-01-08T16:00:00Z", "expect": { "enforcement": { "ritual": "due" } } },
    { "server_time": "2026-01-09T09:00:00Z", "expect": { "enforcement": { "ritual": "missed" } } }
  ]
}
