{
  "name": "ritual-without-settings",
  "description": "Without Workdays and a Shutdown Time there is no Shutdown Ritual and no Shutdown Delay to use.",
  "initial_state": { "blocks": [] },
  "steps": [
    { "server_time": "2026-01-05T17:00:00Z", "expect": { "enforcement": { "ritual": "none" } } },
    {
      "server_time": "2026-01-05T17:00:00Z",
      "command": { "type": "use_shutdown_delay" },
      "expect": { "outcome": "rejected", "reason": "no_shutdown_time" }
    },
    {
      "server_time": "2026-01-05T17:00:00Z",
      "command": { "type": "complete_ritual", "typed": "Shutdown complete" },
      "expect": { "outcome": "rejected", "reason": "ritual_not_due" }
    }
  ]
}
