{
  "name": "long-block-needs-confirmation",
  "description": "A Block longer than 4 hours, started or extended, needs confirm_long; exactly 4 hours doesn't.",
  "initial_state": { "blocks": [] },
  "steps": [
    {
      "server_time": "2026-01-05T09:00:00Z",
      "command": { "type": "start_block", "block_id": "b1", "minutes": 241 },
      "expect": { "outcome": "rejected", "reason": "confirmation_required", "state": { "blocks": [] } }
    },
    {
      "server_time": "2026-01-05T09:00:00Z",
      "command": { "type": "start_block", "block_id": "b1", "minutes": 240 },
      "expect": { "outcome": "accepted" }
    },
    {
      "server_time": "2026-01-05T09:30:00Z",
      "command": { "type": "extend_block", "block_id": "b1", "ends_at": "2026-01-05T13:01:00Z" },
      "expect": { "outcome": "rejected", "reason": "confirmation_required" }
    },
    {
      "server_time": "2026-01-05T09:30:00Z",
      "command": { "type": "extend_block", "block_id": "b1", "ends_at": "2026-01-05T13:01:00Z", "confirm_long": true },
      "expect": { "outcome": "accepted" }
    },
    {
      "server_time": "2026-01-05T09:31:00Z",
      "command": { "type": "start_block", "block_id": "b2", "minutes": 300, "confirm_long": true },
      "expect": {
        "outcome": "accepted",
        "state": {
          "blocks": [
            {
              "id": "b1",
              "starts_at": "2026-01-05T09:00:00Z",
              "ends_at": "2026-01-05T13:01:00Z",
              "blocklists": ["forums", "news", "shopping", "social", "video"],
              "deep": true
            },
            {
              "id": "b2",
              "starts_at": "2026-01-05T09:31:00Z",
              "ends_at": "2026-01-05T14:31:00Z",
              "blocklists": ["forums", "news", "shopping", "social", "video"],
              "deep": true
            }
          ]
        }
      }
    }
  ]
}
