{
  "name": "settings-changed-during-evening-lockdown",
  "description": "Loosening a setting during Evening Lockdown never ends tonight's lockdown early, even after midnight: it takes effect from the next day boundary. Tightening extends it at once.",
  "initial_state": {
    "blocks": [],
    "settings": { "workdays": [1, 2, 3, 4, 5], "workday_start": "09:00", "shutdown_time": "17:00" }
  },
  "steps": [
    {
      "server_time": "2026-01-05T18:00:00Z",
      "command": { "type": "change_settings", "workdays": [1, 2, 3, 4, 5], "workday_start": "09:00", "shutdown_time": "20:00" },
      "expect": {
        "outcome": "accepted",
        "state": {
          "blocks": [],
          "settings": { "workdays": [1, 2, 3, 4, 5], "workday_start": "09:00", "shutdown_time": "17:00" },
          "pending_settings": { "workdays": [1, 2, 3, 4, 5], "workday_start": "09:00", "shutdown_time": "20:00", "effective_at": "2026-01-06T00:00:00Z" }
        },
        "enforcement": { "blocked_domains_include": ["github.com"] }
      }
    },
    {
      "server_time": "2026-01-06T02:00:00Z",
      "command": { "type": "change_settings", "workdays": [1, 2, 3, 4, 5], "workday_start": "06:00", "shutdown_time": "20:00" },
      "expect": {
        "outcome": "accepted",
        "state": {
          "blocks": [],
          "past_settings": [
            { "workdays": [1, 2, 3, 4, 5], "workday_start": "09:00", "shutdown_time": "17:00", "until": "2026-01-06T00:00:00Z" }
          ],
          "settings": { "workdays": [1, 2, 3, 4, 5], "workday_start": "09:00", "shutdown_time": "20:00" },
          "pending_settings": { "workdays": [1, 2, 3, 4, 5], "workday_start": "06:00", "shutdown_time": "20:00", "effective_at": "2026-01-07T00:00:00Z" }
        }
      }
    },
    {
      "server_time": "2026-01-06T07:00:00Z",
      "expect": { "enforcement": { "blocked_domains_include": ["github.com"] } }
    },
    {
      "server_time": "2026-01-06T19:00:00Z",
      "expect": { "enforcement": { "blocked_domains": [] } }
    },
    {
      "server_time": "2026-01-07T06:00:00Z",
      "expect": { "enforcement": { "blocked_domains": [] } }
    },
    {
      "server_time": "2026-01-07T21:00:00Z",
      "command": { "type": "change_settings", "workdays": [1, 2, 4, 5], "workday_start": "06:00", "shutdown_time": "20:00" },
      "expect": {
        "outcome": "accepted",
        "state": {
          "blocks": [],
          "past_settings": [
            { "workdays": [1, 2, 3, 4, 5], "workday_start": "09:00", "shutdown_time": "17:00", "until": "2026-01-06T00:00:00Z" },
            { "workdays": [1, 2, 3, 4, 5], "workday_start": "09:00", "shutdown_time": "20:00", "until": "2026-01-07T00:00:00Z" },
            { "workdays": [1, 2, 3, 4, 5], "workday_start": "06:00", "shutdown_time": "20:00", "until": "2026-01-07T21:00:00Z" }
          ],
          "settings": { "workdays": [1, 2, 4, 5], "workday_start": "06:00", "shutdown_time": "20:00" }
        }
      }
    },
    {
      "server_time": "2026-01-14T12:00:00Z",
      "expect": { "enforcement": { "blocked_domains_include": ["github.com"] } }
    },
    {
      "server_time": "2026-01-14T12:00:00Z",
      "command": { "type": "change_settings", "workdays": [1, 2, 3, 4, 5], "workday_start": "06:00", "shutdown_time": "20:00" },
      "expect": {
        "outcome": "accepted",
        "state": {
          "blocks": [],
          "past_settings": [
            { "workdays": [1, 2, 3, 4, 5], "workday_start": "09:00", "shutdown_time": "17:00", "until": "2026-01-06T00:00:00Z" },
            { "workdays": [1, 2, 3, 4, 5], "workday_start": "09:00", "shutdown_time": "20:00", "until": "2026-01-07T00:00:00Z" },
            { "workdays": [1, 2, 3, 4, 5], "workday_start": "06:00", "shutdown_time": "20:00", "until": "2026-01-07T21:00:00Z" }
          ],
          "settings": { "workdays": [1, 2, 4, 5], "workday_start": "06:00", "shutdown_time": "20:00" },
          "pending_settings": { "workdays": [1, 2, 3, 4, 5], "workday_start": "06:00", "shutdown_time": "20:00", "effective_at": "2026-01-15T00:00:00Z" }
        },
        "enforcement": { "blocked_domains_include": ["github.com"] }
      }
    }
  ]
}
