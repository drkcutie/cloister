{
  "name": "server-time-is-authoritative",
  "description": "Clock tampering: a Device's own clock (client_time) never moves a Block; only server time decides when it starts, ends and what is enforced.",
  "initial_state": { "blocks": [] },
  "steps": [
    {
      "server_time": "2026-01-05T09:00:00Z",
      "command": { "type": "start_block", "block_id": "b1", "minutes": 60, "client_time": "2026-01-05T20:00:00Z" },
      "expect": {
        "outcome": "accepted",
        "state": {
          "blocks": [
            {
              "id": "b1",
              "starts_at": "2026-01-05T09:00:00Z",
              "ends_at": "2026-01-05T10:00:00Z",
              "blocklists": ["forums", "news", "shopping", "social", "video"],
              "deep": true
            }
          ]
        }
      }
    },
    {
      "server_time": "2026-01-05T09:05:00Z",
      "command": { "type": "start_block", "block_id": "b2", "minutes": 30, "client_time": "2025-12-31T23:00:00Z" },
      "expect": {
        "outcome": "accepted",
        "state": {
          "blocks": [
            {
              "id": "b1",
              "starts_at": "2026-01-05T09:00:00Z",
              "ends_at": "2026-01-05T10:00:00Z",
              "blocklists": ["forums", "news", "shopping", "social", "video"],
              "deep": true
            },
            {
              "id": "b2",
              "starts_at": "2026-01-05T09:05:00Z",
              "ends_at": "2026-01-05T09:35:00Z",
              "blocklists": ["forums", "news", "shopping", "social", "video"],
              "deep": true
            }
          ]
        }
      }
    },
    {
      "server_time": "2026-01-05T09:59:00Z",
      "expect": { "enforcement": { "blocked_domains_include": ["youtube.com", "googlevideo.com"] } }
    },
    {
      "server_time": "2026-01-05T10:00:00Z",
      "expect": { "enforcement": { "blocked_domains": [] } }
    }
  ]
}
